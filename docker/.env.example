# SuggestArr — environment configuration
# Copy this file to .env and fill in the values before running docker compose.

# ── App ──
SUGGESTARR_PORT=5000
LOG_LEVEL=info
TZ=Europe/Rome

# ── Database (PostgreSQL) ──
DB_TYPE=postgres
DB_HOST=suggestarr-db
DB_PORT=5432
DB_USER=suggestarr
DB_PASSWORD=changeme-strong-password
DB_NAME=suggestarr